{
  "name": "guerra-de-cocinas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Arcade 2D top-down para 7 jugadores en LAN: dos equipos cocinan y sabotean. Servidor autoritativo Node+ws, cliente Phaser.",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.js --port 3001",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite build && node server/index.js",
    "test": "node --test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "phaser": "^4.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "vite": "^7.3.1"
  }
}
